# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/pharmacy_auth?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Security & Secrets
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8089/login/oauth2/code/google

# First admin account (created by auth-service on startup if it does not exist)
ADMIN_EMAIL=admin@pharmacy.local
ADMIN_PASSWORD=your_admin_password_here

# Razorpay (TEST mode keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Shared secret for service-to-service calls
INTERNAL_API_TOKEN=your_internal_api_token_here
